{
  "name": "@garden/web",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node ./scripts/dev.mjs --containers",
    "dev:local": "node ./scripts/dev.mjs",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "worker:types": "wrangler types worker-configuration.d.ts --include-runtime false --env-file ../../.env.example",
    "worker:types:check": "wrangler types worker-configuration.d.ts --include-runtime false --env-file ../../.env.example --check",
    "skills:seed-builtin": "python3 ./scripts/seed_builtin_skills.py",
    "typecheck": "pnpm run worker:types && tsc -p tsconfig.executor.json --pretty false && tsc -b tsconfig.shared.json --pretty false && tsc -b tsconfig.server.json --pretty false && tsc -b tsconfig.entry.json --pretty false && tsc -p tsconfig.client.json --pretty false && tsc -p tsconfig.tooling.json --pretty false",
    "test": "vitest run",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --fix .",
    "format": "oxfmt -c ../../.oxfmtrc.json --check .",
    "format:write": "oxfmt -c ../../.oxfmtrc.json --write .",
    "deploy": "ALCHEMY_PROFILE=garden-staging ALCHEMY_CI_STATE_STORE_CHECK=false ALCHEMY_TELEMETRY_DISABLED=1 alchemy deploy",
    "clean": "rm -rf .tanstack .output dist .turbo node_modules/.vite",
    "ui:add": "pnpm dlx shadcn@latest add --cwd ../../packages/ui --path components/ui",
    "ui:diff": "pnpm dlx shadcn@latest diff --cwd ../../packages/ui",
    "auth:generate": "node ../../scripts/run-with-root-env.mjs pnpm dlx @better-auth/cli@latest generate --config src/auth.ts",
    "auth:migrate": "node ../../scripts/run-with-root-env.mjs pnpm dlx @better-auth/cli@latest migrate --config src/auth.ts"
  },
