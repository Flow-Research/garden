    "@garden/db": "workspace:*",
    "@garden/env": "workspace:*",
    "@garden/ui": "workspace:*",
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@rive-app/react-webgl2": "^4.28.1",
