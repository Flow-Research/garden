{
  "name": "@garden/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=3072' vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "worker:types": "wrangler types worker-configuration.d.ts --include-runtime false",
    "worker:types:check": "wrangler types worker-configuration.d.ts --include-runtime false --check",
    "typecheck": "pnpm run worker:types:check && tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --fix .",
    "format": "oxfmt -c ../../.oxfmtrc.json --check .",
    "format:write": "oxfmt -c ../../.oxfmtrc.json --write .",
    "deploy": "pnpm run build && wrangler deploy",
    "clean": "rm -rf .tanstack .output dist",
    "ui:add": "pnpm dlx shadcn@latest add --cwd ../../packages/ui --path components/ui",
    "ui:diff": "pnpm dlx shadcn@latest diff --cwd ../../packages/ui",
    "auth:generate": "bash -c 'set -a && source .dev.vars && pnpm dlx @better-auth/cli@latest generate --config src/auth.ts'",
    "auth:migrate": "bash -c 'set -a && source .dev.vars && pnpm dlx @better-auth/cli@latest migrate --config src/auth.ts'"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@cloudflare/ai-chat": "0.4.6",
