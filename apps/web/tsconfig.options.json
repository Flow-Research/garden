{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"],
      "@executor-js/host-mcp/browser-approval": [
        "../../third_party/executor/packages/hosts/mcp/src/browser-approval.ts"
      ],
      "@executor-js/host-mcp/seams": [
        "../../third_party/executor/packages/hosts/mcp/src/seams.ts"
      ],
      "@executor-js/host-mcp/tool-server": [
        "../../third_party/executor/packages/hosts/mcp/src/tool-server.ts"
      ],
      "@executor-js/cloudflare/mcp/agent-durable-object": [
        "../../third_party/executor/packages/hosts/cloudflare/src/mcp/agent-session-durable-object.ts"
      ],
      "@executor-js/cloudflare/mcp/execution-owner-directory": [
        "../../third_party/executor/packages/hosts/cloudflare/src/mcp/execution-owner-directory.ts"
      ],
      "@executor-js/cloudflare/mcp/session-stub": [
        "../../third_party/executor/packages/hosts/cloudflare/src/mcp/session-stub.ts"
      ],
      "@executor-js/runtime-dynamic-worker": [
        "../../third_party/executor/packages/kernel/runtime-dynamic-worker/src/index.ts"
      ],
      "@executor-js/plugin-encrypted-secrets": [
        "../../third_party/executor/packages/plugins/encrypted-secrets/src/index.ts"
      ],
      "@executor-js/plugin-openapi/presets": [
        "../../third_party/executor/packages/plugins/openapi/src/sdk/presets.ts"
      ],
      "@executor-js/plugin-mcp/presets": [
        "../../third_party/executor/packages/plugins/mcp/src/sdk/presets.ts"
      ],
      "@executor-js/plugin-graphql/presets": [
        "../../third_party/executor/packages/plugins/graphql/src/sdk/presets.ts"
      ],
      "@executor-js/plugin-toolkits/server": [
        "../../third_party/executor/packages/plugins/toolkits/src/server.ts"
      ]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "@cloudflare/workers-types"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "disableReferencedProjectLoad": true,
    "disableSolutionSearching": true,
    "disableSourceOfProjectReferenceRedirect": true
  },
  "watchOptions": {
    "excludeDirectories": [
      "**/node_modules",
      "**/.turbo",
      "**/.tanstack",
      "**/.output",
      "**/.wrangler",
      "**/dist"
    ]
  }
}
