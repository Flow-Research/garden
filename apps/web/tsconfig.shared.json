{
  "extends": "./tsconfig.options.json",
  "include": [
    "src/lib/api/document-artifact-contract.ts",
    "src/lib/api/gmail-contract.ts",
    "src/lib/api/garden-api-contract.ts",
    "src/lib/api/skills-contract.ts",
    "src/lib/auth/sign-in-methods.ts",
    "src/lib/executor-contract.ts",
    "src/lib/invitation-flow.ts",
    "src/features/brain/contract.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": "src",
    "outDir": ".turbo/types/shared",
    "tsBuildInfoFile": ".turbo/tsconfig.shared.tsbuildinfo"
  }
}
