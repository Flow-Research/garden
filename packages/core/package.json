    "./automations/run-service": "./automations/run-service.ts",
    "./automations/templates": "./automations/templates.ts",
    "./issues/identifier": "./issues/identifier.ts",
    "./issues/server": "./issues/server.ts",
    "./issues/run-service": "./issues/run-service.ts",
    "./issues/run-sync": "./issues/run-sync.ts",
    "./issues/source-binding": "./issues/source-binding.ts",
    "./issues/triggers": "./issues/triggers.ts",
    "./issues/ws-updaters": "./issues/ws-updaters.ts",
    "./issues/config": "./issues/config/index.ts",
    "./issues/config/status": "./issues/config/status.ts",
