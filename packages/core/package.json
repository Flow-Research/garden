{
  "name": "@garden/core",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --fix .",
    "test": "vitest run"
  },
  "exports": {
    "./types": "./src/types/index.ts",
    "./types/*": "./src/types/*.ts",
    "./agents/permissions": "./src/agents/permissions.ts",
    "./automations/templates": "./src/automations/templates.ts",
    "./issues/deep-link": "./src/issues/deep-link.ts",
    "./issues/identifier": "./src/issues/identifier.ts",
    "./issues/run-sync": "./src/issues/run-sync.ts",
    "./issues/source-binding": "./src/issues/source-binding.ts",
    "./issues/triggers": "./src/issues/triggers.ts",
    "./issues/config": "./src/issues/config/index.ts",
    "./issues/config/status": "./src/issues/config/status.ts",
    "./skills": "./src/skills/index.ts",
    "./skills/*": "./src/skills/*.ts",
    "./utils": "./src/utils.ts",
    "./connectors/errors": "./src/connectors/errors.ts",
    "./constants/*": "./src/constants/*.ts"
  },
  "dependencies": {
    "@garden/db": "workspace:*",
    "@neondatabase/serverless": "^1.0.1",
    "better-result": "^2.9.2",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@garden/tsconfig": "workspace:*",
    "@typescript/native": "catalog:",
    "vitest": "catalog:"
  }
}
