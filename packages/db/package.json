{
  "name": "@garden/db",
  "private": true,
  "type": "module",
  "dependencies": {
    "@garden/env": "workspace:*",
    "@neondatabase/serverless": "^1.0.1",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.7",
    "testcontainers": "^11.10.1",
    "typescript": "^5.9.3",
    "vitest": "catalog:"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --fix .",
    "test": "vitest run",
    "db:check": "bash -c 'set -a && source ../../apps/web/.dev.vars && drizzle-kit check'",
    "db:generate": "bash -c 'set -a && source ../../apps/web/.dev.vars && drizzle-kit generate'",
    "db:migrate": "bash -c 'set -a && source ../../apps/web/.dev.vars && drizzle-kit migrate'",
    "db:sync": "pnpm run db:migrate"
  },
  "exports": {
    ".": "./src/client.ts",
    "./runtime": "./src/runtime.ts",
    "./inbox": "./src/inbox.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/*": "./src/schema/*.ts",
    "./validation": "./src/validation/index.ts",
    "./testing": "./src/testing/index.ts"
  }
}
