  },
  "dependencies": {
    "@garden/core": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "zustand": "catalog:",
    "@garden/observability": "workspace:*"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@garden/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@typescript/native": "catalog:",
    "vitest": "catalog:"
  }
}
