+export type ChatRequestSource =
+  | Readonly<{ kind: "connection"; connectionId: string; connectionTags: readonly string[]; applicationContext?: Readonly<Record<string, unknown>> }>
+  | Readonly<{ kind: "submission"; submissionId: string; metadata: Readonly<Record<string, unknown>> }>
+  | Readonly<{ kind: "programmatic"; applicationContext: Readonly<Record<string, unknown>> }>
+  | Readonly<{ kind: "unattributed" }>;
+export type ChatRequestContext = Readonly<{
+  version: 1;
+  requestId: string;
+  rootRequestId: string;
+  parentRequestId?: string;
+  source: ChatRequestSource;
+  initiatingSources?: readonly ChatRequestSource[];
+}>;
+export type ChatActionContext = Readonly<{
+  request: ChatRequestContext;
+  action: "dispatch-client-tool" | "protocol-event" | "compact-context" | "persist-messages" | "prepare-turn" | "model-step" | "model-call" | "unsupported-model" | "execute-tool" | "apply-tool-result" | "apply-tool-approval" | "approve-execution" | "reject-execution";
+  toolCallId?: string;
+  toolName?: string;
+  input?: unknown;
+  approved?: boolean;
+  approval?: Readonly<{ approved: boolean; request: ChatRequestContext }>;
+  executionId?: string;
+  initiatingRequest?: ChatRequestContext;
+}>;
+export type ChatApplicationOptions = { applicationContext?: Readonly<Record<string, unknown>>; parentReference?: string };
+
+export declare function resultClientToolNames(result: object): readonly string[];
