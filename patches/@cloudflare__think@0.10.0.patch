+import { AsyncLocalStorage } from "node:async_hooks";
+const requestContextStorage = new AsyncLocalStorage();
+const MAX_CONTEXT_BYTES = 8192;
+const MAX_CONTEXT_NODES = 512;
+const MAX_CONTEXT_DEPTH = 8;
+const resultContexts = new WeakMap();
+const resultClientTools = new WeakMap();
+const issuedContexts = new WeakSet();
+
+function freezeJson(value, depth = 0, state = { nodes: 0 }) {
+  if (++state.nodes > MAX_CONTEXT_NODES || depth > MAX_CONTEXT_DEPTH) throw new Error('Chat request context exceeds its bound.');
+  if (value === null || typeof value === 'boolean') return value;
+  if (typeof value === 'string') {
+    if (value.length > 4096) throw new Error('Chat request context string exceeds its bound.');
+    return value;
+  }
+  if (typeof value === 'number' && Number.isFinite(value)) return value;
+  if (Array.isArray(value)) return Object.freeze(value.map((item) => freezeJson(item, depth + 1, state)));
+  if (typeof value !== 'object' || Object.getPrototypeOf(value) !== Object.prototype) throw new Error('Chat request context must contain plain JSON values.');
+  const entries = Object.entries(value);
+  if (entries.some(([key]) => key === '__proto__' || key === 'constructor' || key === 'prototype')) throw new Error('Chat request context contains a reserved key.');
+  return Object.freeze(Object.fromEntries(entries.map(([key, item]) => [key, freezeJson(item, depth + 1, state)])));
+}
+
+function boundedJson(value) {
+  const copy = freezeJson(value);
+  if (new TextEncoder().encode(JSON.stringify(copy)).byteLength > MAX_CONTEXT_BYTES) throw new Error('Chat request context exceeds its byte bound.');
+  return copy;
+}
+
+function identifier(value) {
+  return typeof value === 'string' && value.length > 0 && value.length <= 256;
+}
+
+export function readRequestContext(value) {
+  if (value === undefined || value === null) return newRequestContext({ kind: 'unattributed' });
+  if (typeof value !== 'object' || value.version !== 1 || !identifier(value.requestId) || !identifier(value.rootRequestId) || (value.parentRequestId !== undefined && !identifier(value.parentRequestId))) throw new Error('Chat request context is invalid.');
+  const sources = [value.source, ...(value.initiatingSources ?? [])];
+  if (!Array.isArray(value.initiatingSources ?? []) || sources.length > 16) throw new Error('Chat request lineage exceeds its bound.');
+  for (const source of sources) {
+    if (!source || typeof source !== 'object') throw new Error('Chat request source is invalid.');
+    switch (source.kind) {
+      case 'connection':
+        if (!identifier(source.connectionId) || !Array.isArray(source.connectionTags) || source.connectionTags.length > 16 || source.connectionTags.some((tag) => typeof tag !== 'string' || tag.length > 256)) throw new Error('Chat connection source is invalid.');
+        break;
+      case 'submission':
+        if (!identifier(source.submissionId) || !source.metadata || typeof source.metadata !== 'object' || Array.isArray(source.metadata)) throw new Error('Chat submission source is invalid.');
+        break;
+      case 'programmatic':
+        if (!source.applicationContext || typeof source.applicationContext !== 'object' || Array.isArray(source.applicationContext)) throw new Error('Chat programmatic source is invalid.');
+        break;
+      case 'unattributed': break;
+      default: throw new Error('Chat request source is invalid.');
+    }
+  }
+  const copy = boundedJson(value);
+  issuedContexts.add(copy);
+  return copy;
+}
+
+export function newRequestContext(source, parent) {
+  source = boundedJson(source);
+  const requestId = crypto.randomUUID();
+  const previous = parent ? [...parent.initiatingSources ?? [], parent.source] : [];
+  const seen = new Set([JSON.stringify(source)]);
+  const initiatingSources = previous.filter((item) => {
+    const key = JSON.stringify(item);
+    if (seen.has(key)) return false;
+    seen.add(key);
+    return true;
+  });
+  return readRequestContext({ version: 1, requestId, rootRequestId: parent?.rootRequestId ?? requestId, ...(parent ? { parentRequestId: parent.requestId } : {}), ...(initiatingSources.length ? { initiatingSources } : {}), source });
+}
+
+export function captureRequestContext(connection, applicationContext, parent) {
+  const source = connection
+    ? { kind: 'connection', connectionId: connection.id, connectionTags: [...connection.tags], ...(applicationContext === undefined ? {} : { applicationContext }) }
+    : applicationContext === undefined ? { kind: 'unattributed' } : { kind: 'programmatic', applicationContext };
+  return newRequestContext(source, parent);
+}
+
+export function bindResultContext(result, context, clientTools = []) {
+  if (result && typeof result === 'object') {
+    resultContexts.set(result, context);
+    resultClientTools.set(result, Object.freeze(clientTools.map((tool) => tool.name)));
+  }
+  return result;
+}
+
+export function resultRequestContext(result) {
+  return readRequestContext(resultContexts.get(result));
+}
+
+export function sameRequestSource(left, right) {
+  return JSON.stringify(left.source) === JSON.stringify(right.source);
+}
+
+export function isIssuedRequestContext(value) { return Boolean(value && typeof value === "object" && issuedContexts.has(value)); }
+
+// AsyncLocalStorage preserves per-invocation lineage across compaction and SDK
+// callbacks without sharing a mutable current-source variable between turns.
+export function currentRequestContext() { return requestContextStorage.getStore(); }
+export function runWithRequestContext(context, run) { return requestContextStorage.run(readRequestContext(context), run); }
+
+export function resultClientToolNames(result) { return resultClientTools.get(result) ?? Object.freeze([]); }
+
+// Merge only authority-compatible branches of one pending continuation.
+// Durable tool/application records retain their exact per-effect request IDs.
+export function mergeRequestContexts(left, right) {
+  left = readRequestContext(left);
+  right = readRequestContext(right);
+  if (left.rootRequestId !== right.rootRequestId || !sameRequestSource(left, right)) throw new Error('Chat continuation authority conflicts.');
+  const seen = new Set([JSON.stringify(left.source)]);
+  const initiatingSources = [...left.initiatingSources ?? [], ...right.initiatingSources ?? []].filter((source) => {
+    const key = JSON.stringify(source);
+    if (seen.has(key)) return false;
+    seen.add(key);
+    return true;
+  });
+  return readRequestContext({ ...left, initiatingSources });
+}
