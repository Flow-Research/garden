# Shared local environment for the Garden Worker, Neon tooling, and scripts.
# Keep this project-local; deployed Workers use Cloudflare secrets and bindings.
# Generate BETTER_AUTH_SECRET and EXECUTOR_SECRET_KEY separately with:
#   openssl rand -base64 32
CLOUDFLARE_ACCOUNT_ID=
AI_GATEWAY_ID=

BETTER_AUTH_URL=http://localhost:3000
# Local Docker Postgres from `pnpm offline:up` — the recommended database
# for all local dev. Swap for your own (e.g. Neon) if you need one.
DATABASE_URL=postgresql://garden:garden@localhost:15432/garden
BETTER_AUTH_SECRET=
EXECUTOR_SECRET_KEY=
RESEND_API_KEY=
EXA_API_KEY=
ENVIRONMENT=development

# PostHog is required for deployed Garden builds. The VITE_PUBLIC_* values are
# runtime/browser-safe; POSTHOG_CLI_API_KEY is a PostHog personal API key with
# error_tracking:write, used only by Alchemy/Vite during source-map upload.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_CLI_PROJECT_ID=
POSTHOG_CLI_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_RELEASE_VERSION=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_BOT_PERMISSIONS=

# --- Offline mode (`pnpm dev:offline`) — no Cloudflare account needed -------
# Everything below is optional and commented: `pnpm dev:offline` applies these
# defaults automatically. Uncomment only to override. Local Postgres + Ollama
# come from `pnpm offline:up` / `pnpm offline:up:ollama` (compose.dev.yaml).
# GARDEN_OFFLINE=1
# DATABASE_URL=postgresql://garden:garden@localhost:15432/garden
# GARDEN_MODEL_PROVIDER=openai-compatible
# GARDEN_MODEL_BASE_URL=http://localhost:11434/v1
# GARDEN_MODEL_ID=qwen3:8b
# GARDEN_MODEL_API_KEY=
# GARDEN_MODEL_CONTEXT_WINDOW_TOKENS=32768
#
# Hosted OpenAI-compatible endpoints work too (better quality, needs a key):
# GARDEN_MODEL_BASE_URL=https://openrouter.ai/api/v1
# GARDEN_MODEL_ID=qwen/qwen3-coder
# GARDEN_MODEL_API_KEY=sk-or-...
