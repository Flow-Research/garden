# Local Wrangler/Cloudflare Vite plugin account selection for this repo.
# This is intentionally project-local; do not put it in your global shell if you work across multiple Cloudflare accounts.
CLOUDFLARE_ACCOUNT_ID=

BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
BETTER_AUTH_SECRET=replace-me
RESEND_API_KEY=
ENVIRONMENT=development

# PostHog is required for deployed Garden builds. The VITE_PUBLIC_* values are
# runtime/browser-safe; POSTHOG_API_KEY is a personal API key used only by
# Alchemy/Vite during build-time source-map upload.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_RELEASE_VERSION=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
