# Shared local environment for the Garden Worker, Neon tooling, and scripts.
# Keep this project-local; deployed Workers use Cloudflare secrets and bindings.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MAIL_API_TOKEN=
CLOUDFLARE_MAIL_API_BASE_URL=https://api.cloudflare.com/client/v4
AI_GATEWAY_ID=

BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
BETTER_AUTH_SECRET=replace-me
RESEND_API_KEY=
EXA_API_KEY=
ENVIRONMENT=development

# PostHog is required for deployed Garden builds. The VITE_PUBLIC_* values are
# runtime/browser-safe; POSTHOG_CLI_API_KEY is a PostHog personal API key with
# error_tracking:write, used only by Alchemy/Vite during source-map upload.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_CLI_PROJECT_ID=
POSTHOG_CLI_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_RELEASE_VERSION=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EXECUTOR_SECRET_KEY=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_BOT_PERMISSIONS=
