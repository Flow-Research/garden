{
  "name": "@garden/workspace",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev:local --ui=tui --filter=@garden/web",
    "dev:local": "turbo run dev:local --ui=tui --filter=@garden/web",
    "dev:offline": "turbo run dev:offline --ui=tui --filter=@garden/web",
    "offline:up": "docker compose -f compose.dev.yaml up -d --wait",
    "offline:up:ollama": "docker compose -f compose.dev.yaml --profile ollama up -d --wait",
    "offline:down": "docker compose -f compose.dev.yaml --profile ollama down",
    "dev:containers": "turbo run dev --ui=tui --filter=@garden/web",
    "dev:reset": "pkill -f '[t]urbo run dev|[t]urbo run dev:local|[v]ite dev|[w]orkerd serve|[e]sbuild --service' || true",
    "dev:web": "turbo run dev:local --ui=tui --filter=@garden/web",
    "build": "turbo run build",
    "deploy": "pnpm typecheck && pnpm run deploy:alchemy",
    "deploy:alchemy": "GARDEN_DEPLOY_TARGET=production ALCHEMY_STAGE=production ALCHEMY_TELEMETRY_DISABLED=1 alchemy deploy --adopt",
    "deploy:preview": "pnpm typecheck && pnpm run deploy:preview:alchemy",
    "deploy:preview:alchemy": "GARDEN_DEPLOY_TARGET=preview ALCHEMY_STAGE=preview ALCHEMY_TELEMETRY_DISABLED=1 alchemy deploy --adopt",
    "destroy:preview": "GARDEN_DEPLOY_TARGET=preview ALCHEMY_STAGE=preview ALCHEMY_TELEMETRY_DISABLED=1 alchemy destroy --adopt",
    "verify:deploy-config": "node scripts/verify-deploy-config.mjs",
    "typecheck": "turbo run typecheck --concurrency=1",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "verify:connectors": "pnpm --filter @garden/connectors verify:coverage",
    "format": "oxfmt -c ./.oxfmtrc.json --check apps packages",
    "format:write": "oxfmt -c ./.oxfmtrc.json --write apps packages",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@garden/connectors": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@typescript/native": "catalog:",
    "alchemy": "2.0.0-beta.74",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "turbo": "2.9.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "workerd"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "@cloudflare/workers-types": "^4.20260424.1 || ^5.20260714.1"
      }
    },
    "overrides": {
      "alchemy>miniflare": "4.20260714.0",
      "@posthog/cli": "0.8.4",
      "effect": "4.0.0-rc.111",
      "@effect/atom-react": "4.0.0-rc.111",
      "@effect/platform-node": "4.0.0-rc.111",
      "@effect/platform-node-shared": "4.0.0-rc.111",
      "@effect/vitest": "4.0.0-rc.111",
      "@babel/core": "7.29.6",
      "@modelcontextprotocol/sdk": "1.30.0",
      "@modelcontextprotocol/sdk>@hono/node-server": "2.0.10",
      "@tanstack/start-server-core": "1.167.30",
      "body-parser": "2.3.0",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@>=4 <6": "5.0.9",
      "dompurify": "3.4.13",
      "esbuild": "0.28.1",
      "fast-uri": "3.1.5",
      "hono": "4.12.34",
      "ip-address": "10.3.1",
      "js-yaml": "4.3.1",
      "kysely": "0.28.17",
      "linkify-it": "5.0.2",
      "mermaid": "11.16.1",
      "miniflare@4>sharp": "0.35.3",
      "nanoid@3": "3.3.17",
      "nanoid@>=4 <6": "5.1.16",
      "launch-editor": "2.14.1",
      "postcss": "8.5.23",
      "qs": "6.15.2",
      "seroval": "1.5.5",
      "seroval-plugins": "1.5.5",
      "shell-quote": "1.9.0",
      "undici@7": "7.29.0",
      "undici@8": "8.9.0",
      "ws": "8.21.0"
    },
    "patchedDependencies": {
      "agents@0.17.3": "patches/agents@0.17.3.patch"
    }
  },
  "dependencies": {
    "better-result": "^2.9.2"
  }
}
