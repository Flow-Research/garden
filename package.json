{
  "name": "@garden/workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "GARDEN_WAIT_FOR_MCP_PROXY=1 turbo run dev --ui=tui --filter=@garden/mcp-proxy --filter=@garden/web",
    "dev:web": "turbo run dev --ui=tui --filter=@garden/web",
    "dev:web:containers": "pnpm --filter @garden/web dev:containers",
    "build": "turbo run build",
    "deploy": "pnpm --filter @garden/mcp-proxy deploy && pnpm --filter @garden/web deploy",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "verify:connectors": "node --experimental-strip-types scripts/verify-connector-coverage.ts",
    "check:github-mcp": "node --experimental-strip-types scripts/check-github-mcp.ts",
    "format": "oxfmt -c ./.oxfmtrc.json --check apps packages",
    "format:write": "oxfmt -c ./.oxfmtrc.json --write apps packages",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "create-garden-connector": "workspace:*",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "turbo": "^2.5.8",
    "typescript": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "create-garden-connector": "workspace:*"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "workerd"
    ],
    "patchedDependencies": {
      "@cloudflare/vite-plugin@1.36.0": "patches/@cloudflare__vite-plugin@1.36.0.patch"
    }
  },
  "dependencies": {
    "better-result": "^2.9.2"
  }
}
