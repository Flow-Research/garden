{
  "name": "@garden/workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev --ui=tui --filter=@garden/mcp-proxy --filter=@garden/web",
    "dev:local": "turbo run dev:local --ui=tui --filter=@garden/mcp-proxy --filter=@garden/web",
    "dev:reset": "pkill -f '[t]urbo run dev|[t]urbo run dev:local|[w]rangler dev --port 8788|[v]ite dev|[w]orkerd serve|[e]sbuild --service' || true",
    "dev:web": "turbo run dev --ui=tui --filter=@garden/web",
    "build": "turbo run build",
    "deploy": "pnpm run deploy:alchemy && pnpm run deploy:mcp-proxy",
    "deploy:alchemy": "ALCHEMY_PROFILE=garden-staging ALCHEMY_CI_STATE_STORE_CHECK=false ALCHEMY_TELEMETRY_DISABLED=1 alchemy deploy",
    "deploy:mcp-proxy": "env -u WRANGLER_CI_OVERRIDE_NAME -u WRANGLER_CI_MATCH_TAG wrangler deploy --config workers/mcp-proxy/wrangler.jsonc --keep-vars",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "verify:connectors": "pnpm --filter @garden/connectors verify:coverage",
    "check:github-mcp": "pnpm --filter @garden/connectors check:github-mcp",
    "format": "oxfmt -c ./.oxfmtrc.json --check apps packages",
    "format:write": "oxfmt -c ./.oxfmtrc.json --write apps packages",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@garden/connectors": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "alchemy": "^0.93.10",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "turbo": "^2.5.8",
    "typescript": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "workerd"
    ],
    "patchedDependencies": {}
  },
  "dependencies": {
    "better-result": "^2.9.2"
  }
}
