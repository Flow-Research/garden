{
  "name": "@garden/workspace",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "turbo run dev:local --ui=tui --filter=@garden/web",
    "dev:local": "turbo run dev:local --ui=tui --filter=@garden/web",
    "dev:offline": "turbo run dev:offline --ui=tui --filter=@garden/web",
    "offline:up": "docker compose -f compose.dev.yaml up -d --wait",
    "offline:up:ollama": "docker compose -f compose.dev.yaml --profile ollama up -d --wait",
    "offline:down": "docker compose -f compose.dev.yaml --profile ollama down",
    "dev:containers": "turbo run dev --ui=tui --filter=@garden/web",
    "dev:reset": "pkill -f '[t]urbo run dev|[t]urbo run dev:local|[v]ite dev|[w]orkerd serve|[e]sbuild --service' || true",
    "dev:web": "turbo run dev:local --ui=tui --filter=@garden/web",
    "verify:pr": "node scripts/verify-pr-contract.mjs",
    "doctor": "node scripts/garden-doctor.mjs",
    "build": "turbo run build",
    "deploy": "pnpm typecheck && pnpm run deploy:migrate && pnpm run deploy:alchemy",
    "deploy:ci": "node scripts/deploy-ci.mjs",
    "deploy:dev": "pnpm typecheck && node scripts/deploy-dev.mjs",
    "deploy:dev:alchemy": "GARDEN_DEPLOY_TARGET=dev ALCHEMY_TELEMETRY_DISABLED=1 alchemy deploy --stage dev --yes",
    "deploy:migrate": "pnpm --filter @garden/db db:migrate",
    "deploy:alchemy": "GARDEN_DEPLOY_TARGET=staging ALCHEMY_TELEMETRY_DISABLED=1 alchemy deploy --stage production --yes",
    "deploy:preview": "pnpm typecheck && pnpm run deploy:preview:alchemy",
    "deploy:preview:alchemy": "GARDEN_DEPLOY_TARGET=preview ALCHEMY_TELEMETRY_DISABLED=1 alchemy deploy --stage preview --yes",
    "destroy:preview": "GARDEN_DEPLOY_TARGET=preview ALCHEMY_TELEMETRY_DISABLED=1 alchemy destroy --stage preview --yes",
    "verify:deploy-config": "node scripts/verify-deploy-config.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:diagrams": "node scripts/diagrams.mjs check",
    "diagrams:export": "node scripts/diagrams.mjs export",
    "verify:code-policy": "node scripts/verify-code-policy.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:smoke": "node --test scripts/smoke.test.mjs",
    "test:pr-contract": "node --test scripts/pr-evidence.test.mjs scripts/diagram-contract.test.mjs scripts/diagrams.test.mjs",
    "screenshot:webp": "node scripts/screenshot-webp.mjs",
    "typecheck": "turbo run typecheck --concurrency=1",
    "test": "turbo run test && pnpm run test:dependency-security",
    "test:dependency-security": "node --test scripts/dependency-security.test.mjs scripts/parser-transport.test.mjs scripts/build-tooling-dependencies.test.mjs",
    "lint": "turbo run lint && pnpm run lint:root",
    "lint:root": "oxlint -c ./.oxlintrc.json scripts alchemy.run.ts deploy-targets.mjs",
    "verify:connectors": "pnpm --filter @garden/connectors verify:coverage",
    "format": "oxfmt -c ./.oxfmtrc.json --check apps packages workers scripts alchemy.run.ts deploy-targets.mjs",
    "format:write": "oxfmt -c ./.oxfmtrc.json --write apps packages workers scripts alchemy.run.ts deploy-targets.mjs",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@garden/connectors": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@typescript/native": "catalog:",
    "alchemy": "2.0.0-beta.74",
    "oxc-parser": "0.95.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "proxy-addr": "2.0.8",
    "seroval": "1.6.11",
    "sharp": "0.35.5",
    "shell-quote": "1.11.0",
    "turbo": "2.9.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "workerd"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "@cloudflare/workers-types": "^4.20260424.1 || ^5.20260714.1"
      }
    },
    "overrides": {
      "alchemy>miniflare": "4.20260714.0",
      "@posthog/cli": "0.8.4",
      "sharp": "0.35.5",
      "effect": "4.0.0-rc.111",
      "@effect/atom-react": "4.0.0-rc.111",
      "@effect/platform-node": "4.0.0-rc.111",
      "@effect/platform-node-shared": "4.0.0-rc.111",
      "@effect/vitest": "4.0.0-rc.111",
      "@babel/core": "7.29.6",
      "@modelcontextprotocol/sdk": "1.32.2",
      "@modelcontextprotocol/sdk>@hono/node-server": "2.0.10",
      "zod@4": "4.6.6",
      "@tanstack/start-server-core": "1.169.39",
      "body-parser": "2.4.0",
      "body-parser@2.4.0>qs": "6.16.1",
      "brace-expansion@1": "1.1.22",
      "brace-expansion@2": "2.1.8",
      "brace-expansion@>=4 <6": "5.0.13",
      "browserslist@4": "4.28.7",
      "dompurify": "3.4.13",
      "esbuild": "0.28.1",
      "fast-uri": "3.1.7",
      "hono": "4.12.34",
      "ip-address": "10.3.1",
      "isomorphic-git@1": "1.38.6",
      "js-yaml": "4.3.2",
      "kysely": "0.28.17",
      "linkify-it": "5.0.2",
      "mermaid": "11.16.1",
      "nanoid@3": "3.3.18",
      "nanoid@>=4 <6": "5.1.16",
      "launch-editor": "2.14.2",
      "postcss": "8.5.26",
      "qs": "6.15.2",
      "seroval": "1.6.11",
      "seroval-plugins": "1.6.8",
      "shell-quote": "1.11.0",
      "undici@7": "7.30.1",
      "undici@8": "8.12.2",
      "ws": "8.21.0",
      "proxy-addr": "2.0.8",
      "@fastify/busboy@3": "3.2.1",
      "@xmldom/xmldom@0.8": "0.8.15",
      "smol-toml@1": "1.7.1",
      "source-map-js@1": "1.2.2",
      "vite@8": "8.2.4"
    },
    "patchedDependencies": {
      "@helix-db/helix-db@3.0.2": "patches/@helix-db__helix-db@3.0.2.patch",
      "@executor-js/sdk@1.5.40": "patches/@executor-js__sdk@1.5.40.patch",
      "@executor-js/config@1.5.40": "patches/@executor-js__config@1.5.40.patch",
      "@executor-js/execution@1.5.40": "patches/@executor-js__execution@1.5.40.patch",
      "@executor-js/plugin-graphql@1.5.40": "patches/@executor-js__plugin-graphql@1.5.40.patch",
      "@executor-js/plugin-mcp@1.5.40": "patches/@executor-js__plugin-mcp@1.5.40.patch",
      "@executor-js/plugin-openapi@1.5.40": "patches/@executor-js__plugin-openapi@1.5.40.patch",
      "better-auth@1.7.16": "patches/better-auth@1.7.16.patch",
      "mammoth@1.12.0": "patches/mammoth@1.12.0.patch",
      "@xmldom/xmldom@0.8.15": "patches/@xmldom__xmldom@0.8.15.patch"
    }
  }
}
