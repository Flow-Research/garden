{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["DATABASE_URL"],
  "globalPassThroughEnv": [
    "CF_*",
    "CLOUDFLARE_*",
    "DOCKER_HOST",
    "EXECUTOR_SECRET_KEY",
    "GARDEN_*",
    "HOST",
    "PORT",
    "PORTLESS_*",
    "POSTGRES_DB",
    "POSTGRES_PORT",
    "REQUIRE_CONTAINERS",
    "WRANGLER_*"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", "build/**", "!.output/cache/**"],
      "env": [
        "VITE_*",
        "POSTHOG_*",
        "ENABLE_DEVTOOLS",
        "GITHUB_SHA",
        "WORKERS_CI_COMMIT_SHA"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interactive": true,
      "interruptible": true
    },
    "dev:local": {
      "cache": false,
      "persistent": true,
      "interactive": true,
      "interruptible": true
    },
    "dev:offline": {
      "cache": false,
      "persistent": true,
      "interactive": true,
      "interruptible": true
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "clean": {
      "cache": false
    }
  }
}
